# Server
PORT=5000
NODE_ENV=development

# Database
# Use a local database for development. Keep real credentials in an untracked .env.
DB_URI=mongodb://127.0.0.1:27017/agri-trace
# Set true for a disposable local demo database.
USE_IN_MEMORY_DB=false

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_LIFETIME=7d

# Blockchain
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=replace_with_local_development_private_key
CONTRACT_ADDRESS=replace_with_deployed_contract_address

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# Web frontend for QR URL generation
FRONTEND_URL=http://localhost:3000

# Live plant-disease WebSocket
LIVE_DISEASE_PATH=/api/v1/disease-detections/live
LIVE_DISEASE_MAX_CONNECTIONS=16
LIVE_DISEASE_MAX_FRAME_BYTES=5242880
LIVE_DISEASE_SMOOTHING_WINDOW=5
LIVE_DISEASE_EVENT_COOLDOWN_MS=300000

# Camera / MediaMTX
CAMERA_OFFLINE_AFTER_MS=90000
CAMERA_FRAME_TIMEOUT_MS=15000
CAMERA_MAX_FRAME_BYTES=5242880
FFMPEG_PATH=ffmpeg
MEDIA_INTERNAL_RTSP_BASE=rtsp://mediamtx:8554
MEDIA_CONTROL_API_BASE=http://mediamtx:9997
MEDIA_PUBLIC_WEBRTC_BASE=http://localhost:8889
MEDIA_PUBLIC_HLS_BASE=http://localhost:8888
